{
  "name": "paperballs",
  "version": "1.0.0",
  "description": "A strategic grid game recreated from childhood memories - place balls, move strategically, align to win!",
  "main": "web/js/game.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhanjit/paperballs.git"
  },
  "keywords": [
    "game",
    "strategy",
    "grid",
    "board-game",
    "paper-balls"
  ],
  "author": "Dhanjit Das",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dhanjit/paperballs/issues"
  },
  "homepage": "https://github.com/dhanjit/paperballs#readme",
  "devDependencies": {
    "jest": "^30.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "web/js/game.js",
      "web/js/ai.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 85,
        "statements": 85
      }
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
